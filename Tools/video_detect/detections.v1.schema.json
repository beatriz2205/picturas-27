{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://picturas.local/schemas/detections.v1.schema.json",
  "type": "object",
  "required": ["schemaVersion", "source", "task", "classes", "frames"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "required": ["videoId", "durationS", "fps", "width", "height", "frameCount"],
      "properties": {
        "videoId": { "type": "string" },
        "durationS": { "type": "number", "minimum": 0 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "frameCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["id", "tools", "threshold", "model"],
      "properties": {
        "id": { "type": "string" },
        "tools": { "type": "array", "items": { "enum": ["people_ai", "obj_ai"] }, "minItems": 1, "uniqueItems": true },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "model": { "const": "yolov5su" }
      },
      "additionalProperties": false
    },
    "classes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "timeS", "detections"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "timeS": { "type": "number", "minimum": 0 },
          "detections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["tool", "class", "confidence", "box"],
              "properties": {
                "tool": { "enum": ["people_ai", "obj_ai"] },
                "class": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "box": {
                  "type": "object",
                  "required": ["cx", "cy", "w", "h"],
                  "properties": {
                    "cx": { "type": "number", "minimum": 0, "maximum": 1 },
                    "cy": { "type": "number", "minimum": 0, "maximum": 1 },
                    "w": { "type": "number", "minimum": 0, "maximum": 1 },
                    "h": { "type": "number", "minimum": 0, "maximum": 1 }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
